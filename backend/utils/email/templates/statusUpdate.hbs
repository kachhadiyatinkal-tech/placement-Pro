<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>Application Status Updated</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style type="text/css">
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f8fafc;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      border: 1px solid #e2e8f0;
    }
    .header {
      padding: 40px;
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      text-align: center;
      color: #ffffff;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.025em;
    }
    .content {
      padding: 40px;
      color: #1e293b;
      line-height: 1.6;
    }
    .content p {
      margin-bottom: 24px;
      font-size: 16px;
    }
    .status-badge {
      display: inline-block;
      padding: 8px 16px;
      background-color: #fef3c7;
      color: #92400e;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 24px;
    }
    .status-updated {
      background-color: #e0e7ff;
      color: #4338ca;
    }
    .job-card {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 24px;
      margin: 24px 0;
    }
    .job-title {
      font-size: 18px;
      font-weight: 700;
      color: #1e293b;
      margin: 0 0 8px 0;
    }
    .company-name {
      font-size: 14px;
      font-weight: 600;
      color: #6366f1;
      margin: 0;
    }
    .footer {
      padding: 24px;
      background-color: #f1f5f9;
      text-align: center;
      color: #64748b;
      font-size: 12px;
    }
    .footer p {
      margin: 4px 0;
    }
    .divider {
      height: 1px;
      background-color: #e2e8f0;
      margin: 24px 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>PLACEMENTPRO</h1>
    </div>
    <div class="content">
      <p>Hello <strong>{{studentName}}</strong>,</p>
      <p>Your application status for the following position has been updated.</p>
      
      <div class="status-badge status-updated">New Status: {{newStatus}}</div>

      <div class="job-card">
        <h2 class="job-title">{{jobTitle}}</h2>
        <p class="company-name">{{companyName}}</p>
      </div>

      {{#if isInterview}}
      <p><strong>Interview Details:</strong></p>
      <ul>
        {{#if interviewDate}}<li>Date: {{interviewDate}}</li>{{/if}}
        {{#if interviewTime}}<li>Time: {{interviewTime}}</li>{{/if}}
        {{#if meetingLink}}<li>Meeting Link: <a href="{{meetingLink}}">{{meetingLink}}</a></li>{{/if}}
      </ul>
      {{/if}}

      <p>You can view more details and track your application journey through your student dashboard.</p>
      
      <p>Best regards,<br>The Recruitment Team</p>
      
      <div class="divider"></div>
      
      <p style="font-size: 12px; color: #64748b;">This is an automated notification. You don't need to reply to this email.</p>
    </div>
    <div class="footer">
      <p>&copy; 2026 PLACEMENTPRO Suite</p>
      <p>Cloud Infrastructure Active</p>
    </div>
  </div>
</body>
</html>