<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>Account Status Updated</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style type="text/css">
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f8fafc;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      border: 1px solid #e2e8f0;
    }
    .header {
      padding: 40px;
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      text-align: center;
      color: #ffffff;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.025em;
    }
    .content {
      padding: 40px;
      color: #1e293b;
      line-height: 1.6;
    }
    .content p {
      margin-bottom: 24px;
      font-size: 16px;
    }
    .status-badge {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 24px;
    }
    .accepted {
      background-color: #ecfdf5;
      color: #059669;
    }
    .rejected {
      background-color: #fef2f2;
      color: #dc2626;
    }
    .action-container {
      text-align: center;
      margin: 32px 0;
    }
    .button {
      background-color: #4f46e5;
      color: #ffffff !important;
      padding: 16px 32px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: inline-block;
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }
    .footer {
      padding: 24px;
      background-color: #f1f5f9;
      text-align: center;
      color: #64748b;
      font-size: 12px;
    }
    .footer p {
      margin: 4px 0;
    }
    .divider {
      height: 1px;
      background-color: #e2e8f0;
      margin: 24px 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>PLACEMENTPRO</h1>
    </div>
    <div class="content">
      <p>Hello <strong>{{companyName}}</strong>,</p>
      <p>Your account registration on PLACEMENTPRO has been reviewed by the administration.</p>
      
      <div class="status-badge {{#if isAccepted}}accepted{{else}}rejected{{/if}}">
        Status: {{status}}
      </div>

      {{#if isAccepted}}
        <p>Congratulations! Your account has been approved. You can now log in to post job opportunities and manage your recruitment process.</p>
        <div class="action-container">
          <a href="{{loginUrl}}" class="button">Access Dashboard</a>
        </div>
      {{else}}
        <p>Unfortunately, your account registration has been rejected at this time. If you believe this is a mistake or would like to provide more information, please contact our support team.</p>
      {{/if}}

      <p>Best regards,<br>The PLACEMENTPRO Team</p>
      
      <div class="divider"></div>
      
      <p style="font-size: 12px; color: #64748b;">This is an automated notification. You don't need to reply to this email.</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} PLACEMENTPRO Suite</p>
      <p>Cloud Infrastructure Active</p>
    </div>
  </div>
</body>
</html>
